---
import '../styles/global.css';
import { SITE } from '../site';

interface Props { title?: string; description?: string; image?: string; overlayHeader?: boolean }
const { title, description = SITE.description, image, overlayHeader = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.author}` : `${SITE.title} | ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/travel/', label: 'Travel' },
  { href: '/adventure/', label: 'Adventure' },
  { href: '/tech/', label: 'Tech' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="theme-color" content="#0f1b33" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class:list={['site-header', { overlay: overlayHeader }]}>
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="brand-name">{SITE.title}</span>
          <span class="brand-by">by {SITE.author}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer on-dark">
      <div class="wrap foot">
        <div>
          <p class="foot-brand">{SITE.title}</p>
          <p class="foot-tag">{SITE.tagline}</p>
        </div>
        <div class="foot-links">
          <ul aria-label="Social">
            {SITE.social.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.name}</a></li>)}
          </ul>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a> &nbsp;/&nbsp; <a href="/rss.xml">RSS feed</a></p>
        </div>
      </div>
      <div class="wrap copy">© {new Date().getFullYear()} {SITE.author}</div>
    </footer>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 1rem; left: 1rem; width: auto; height: auto; clip: auto; z-index: 10;
    background: var(--gold); color: var(--night); padding: 0.5rem 1rem; }

  .site-header { background: var(--night); color: #fff; }
  .site-header.overlay { position: absolute; inset: 0 0 auto 0; z-index: 5; background: linear-gradient(rgba(15,27,51,.75), transparent); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 1.1rem; }
  .brand { text-decoration: none; display: flex; align-items: baseline; gap: 0.6rem; }
  .brand-name { font-family: var(--serif); font-size: 1.6rem; font-weight: 600; color: var(--gold-soft); }
  .brand-by { font-size: var(--step--1); color: rgba(255,255,255,.7); }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.9rem, 3vw, 2rem); }
  nav a { color: rgba(255,255,255,.85); text-decoration: none; font-size: 0.95rem; padding-block: 0.3rem; border-bottom: 2px solid transparent; }
  nav a:hover { color: #fff; }
  nav a[aria-current='page'] { color: #fff; border-bottom-color: var(--gold); }

  .site-footer { background: var(--night); color: rgba(255,255,255,.75); margin-top: 6rem; padding-block: 3.5rem 1.5rem; }
  .foot { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .foot-brand { font-family: var(--serif); font-size: 2rem; color: var(--gold-soft); margin: 0; }
  .foot-tag { font-family: var(--serif); font-style: italic; font-size: 1.25rem; margin: 0.25rem 0 0; }
  .foot-links ul { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .site-footer a { color: #fff; }
  .site-footer a:hover { color: var(--gold-soft); }
  .copy { border-top: 1px solid rgba(255,255,255,.12); margin-top: 2.5rem; padding-top: 1.25rem; font-size: var(--step--1); }
</style>
