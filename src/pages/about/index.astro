---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
import { getPosts } from '../../lib';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
const journeys = (await getPosts()).filter((p) => p.data.category !== 'tech');

const work = [
  ['Business planning and strategy', 'Consulting across several sectors on where a business should go and how to get there.'],
  ['ERP implementation', 'Implementing and customising ERP solutions to fit how organisations actually run.'],
  ['ICT strategy', 'IT roadmaps and feasibility studies that tie technology spend to business goals.'],
  ['IS audit and IT security', 'Information systems audits and security reviews.'],
  ['Programme and project management', 'Delivering complex programmes as a PMP-certified project manager.'],
  ['AI and automation', 'Building applications with emerging AI tools, and helping small businesses automate their processes.'],
];
---
<Base title="About" description="Padmanabhan: 35+ years in IT, AI practitioner, founder of Elpi Ventures, and a traveller who likes his adventures with an adrenaline kick.">
  <header class="intro on-dark">
    <div class="wrap cols">
      <div>
        <h1>About me</h1>
        <p class="lede">I’m Padmanabhan. I’ve spent over 35 years in information technology, and as much of my free time as I can out in the world.</p>
      </div>
      {portrait && <Image class="portrait" src={portrait} alt="Padmanabhan" widths={[320, 640]} sizes="16rem" />}
    </div>
  </header>

  <div class="wrap body">
    <section class="prose">
      <h2>A career in technology</h2>
      <p>I started as a programmer on IBM mainframes and have worked across many hardware and software platforms since. Along the way I moved into consulting, helping organisations plan, choose and run the technology behind their business.</p>
      <p>Today I work as an AI practitioner, building applications with the newest generation of AI tools. I also run <a href="https://elpi.io" rel="noopener">Elpi Ventures</a>, where I help small and mid-sized businesses use AI and process automation to get measurable returns.</p>
    </section>

    <section aria-labelledby="work">
      <h2 id="work">What I’ve worked on</h2>
      <dl class="work">
        {work.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
      </dl>
    </section>

    <section class="prose" aria-labelledby="travel">
      <h2 id="travel">Why travel</h2>
      <p>Travel keeps me curious in the same way technology does. I’ve been to Europe, Asia and across India, and I prefer trips with something to do: a skydive, a boat ride through the fjords, a night in the desert or a walk into a cave.</p>
      <p>This site is where both worlds meet: <a href="/travel/">travel stories</a>, <a href="/adventure/">adventures</a> and <a href="/tech/">writing on technology</a>.</p>
      <ul class="places">
        {journeys.map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
      </ul>
    </section>

    <section class="contact" aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p>I’d love to hear from you, whether it’s about a place I’ve written about, a question on a tech post, or just to say hello.</p>
      <p>Write to me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me on{' '}
        {SITE.social.map((s, i) => (
          <>{i > 0 && (i === SITE.social.length - 1 ? ' and ' : ', ')}<a href={s.url} rel="me noopener" target="_blank">{s.name}</a></>
        ))}.</p>
    </section>
  </div>
</Base>
<style>
  .intro { background: var(--ink); color: #fff; padding-block: 4rem 3.5rem; }
  .cols { display: flex; justify-content: space-between; align-items: center; gap: 2.5rem; flex-wrap: wrap; }
  .intro h1 { color: #fff; font-size: var(--step-5); font-weight: 500; margin-bottom: 0.75rem; }
  .lede { font-family: var(--serif); font-size: var(--step-2); line-height: 1.3; color: rgba(255,255,255,.9); max-width: 30ch; margin: 0; }
  .portrait { width: 16rem; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 3px solid var(--gold); }
  .body > * { max-width: 46rem; }
  .body section { margin-top: 4rem; }
  .prose p { font-size: 1.125rem; line-height: 1.75; }
  .work { margin: 0; }
  .work div { padding-block: 1.1rem; border-top: 1px solid var(--rule); display: grid; gap: 0.25rem 2rem; }
  .work dt { font-family: var(--serif); font-size: var(--step-1); font-weight: 600; color: var(--ink); }
  .work dd { margin: 0; color: var(--muted); }
  @media (min-width: 48rem) { .work div { grid-template-columns: 15rem 1fr; } }
  .places { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .places a { display: inline-block; padding: 0.35rem 0.85rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--surface); text-decoration: none; color: var(--ink); font-size: 0.95rem; }
  .places a:hover { border-color: var(--gold); }
  .contact p { font-size: 1.125rem; }
</style>
