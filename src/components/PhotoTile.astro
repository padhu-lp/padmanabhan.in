---
import Cover from './Cover.astro';
import { CATEGORIES, formatDate } from '../site';
interface Props { post: any; large?: boolean }
const { post, large = false } = Astro.props;
const { title, category, date, description } = post.data;
---
<article class:list={['tile', { large }]}>
  <a class="img" href={`/${post.id}/`} tabindex="-1" aria-hidden="true">
    <Cover post={post} sizes={large ? '(min-width: 64rem) 60vw, 100vw' : '(min-width: 64rem) 30vw, 100vw'} />
  </a>
  <div class="body">
    <a class="tag" href={`/${category}/`}>{CATEGORIES[category].label}</a>
    <h3><a href={`/${post.id}/`}>{title}</a></h3>
    <p class="desc">{description}</p>
    <p class="meta"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
  </div>
</article>
<style>
  .tile { display: flex; flex-direction: column; gap: 1rem; }
  .img { display: block; overflow: hidden; border-radius: 4px; }
  .img :global(img), .img :global(.cover-fallback) { width: 100%; aspect-ratio: 3/2; object-fit: cover; transition: transform .6s ease; }
  .tile:hover .img :global(img) { transform: scale(1.03); }
  h3 { font-size: var(--step-2); margin: 0.35rem 0 0.4rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--gold); }
  .desc { margin: 0 0 0.4rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { margin: 0; }
  @media (min-width: 52rem) {
    .large { display: grid; grid-template-columns: 3fr 2fr; gap: 2.5rem; align-items: center; }
    .large .img :global(img), .large .img :global(.cover-fallback) { aspect-ratio: 16/10; }
    .large h3 { font-size: var(--step-4); }
  }
</style>
